<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fragment 容器 -->

    <!-- 自定义底部导航背景 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <com.fishmemory.app.ui.common.BottomNavWithFab
        android:id="@+id/bottom_nav_bg"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"/>

    <!-- 中间 + 号（主操作） -->

    <!-- Tab Icons -->
    <LinearLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iv_home"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_home"
                app:tint="@color/nav_item_icon_tint"/>
            <TextView
                android:id="@+id/tv_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="首页"
                android:textColor="@color/nav_item_icon_tint"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabHot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iv_hot"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_hot"
                app:tint="@color/nav_item_icon_tint"/>
            <TextView
                android:id="@+id/tv_hot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="沸点"
                android:textColor="@color/nav_item_icon_tint"/>
        </LinearLayout>

        <!-- 占位 -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <LinearLayout
            android:id="@+id/tabMsg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iv_msg"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_message"
                app:tint="@color/nav_item_icon_tint"/>
            <TextView
                android:id="@+id/tv_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="消息"
                android:textColor="@color/nav_item_icon_tint"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabMe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iv_me"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/nav_item_icon_tint"/>
            <TextView
                android:id="@+id/tv_me"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我"
                android:textColor="@color/nav_item_icon_tint"/>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_publish"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="60dp"
        android:src="@drawable/ic_nav_add"
        android:scaleType="centerCrop"
        app:backgroundTint="@color/app_primary"
        app:tint="@color/app_background"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
