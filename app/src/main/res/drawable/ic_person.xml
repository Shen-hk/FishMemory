        android:fillColor="#FFFFFF"
        android:pathData="M48,48m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0" />

    <!-- 灰色人形图标（居中，适当缩放） -->
    <group
        android:translateX="1.5"
        android:translateY="2"
        android:scaleX="2.0"
        android:scaleY="2.0">
        <path
            android:fillColor="#757575"
            android:pathData="M24,24c3.31,0 6,-2.69 6,-6s-2.69,-6 -6,-6 -6,2.69 -6,6 2.69,6 6,6zM24,27c-5.52,0 -10,1.79 -10,6v2h20v-2c0,-4.21 -4.48,-6 -10,-6z" />
