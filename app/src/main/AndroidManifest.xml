<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FishMemory"
        tools:targetApi="31">
        <!-- 启动选择器（主入口） -->
        <activity
            android:name=".LauncherActivity"
            android:exported="false"
            android:theme="@style/Theme.FishMemory">
        </activity>

        <!-- Compose版本主界面 -->
        <activity
            android:name=".compose.ComposeMainActivity"
            android:exported="false"
            android:theme="@style/Theme.FishMemory" />

        <!-- XML版本主界面 -->
        <activity
            android:name=".xml.activity.XmlMainActivity"
            android:exported="false"
            android:theme="@style/Theme.FishMemory" />

        <!-- XML版本文章详情页 -->
        <activity
            android:name=".xml.activity.ArticleDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.FishMemory"
            tools:ignore="Instantiatable" />
        <!-- XML版本沸点详情页 -->
        <activity
            android:name=".xml.activity.HotRankingActivity"
            android:exported="false" />

        <!-- 原有的MainActivity改为备用（可选） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FishMemory">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        </activity>

    </application>


</manifest>